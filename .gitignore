# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Dependencies / build output
node_modules/
dist/
build/
target/
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs / local scratch
*.log
tmp/
scratch/

# Local data — the decision record must never be committed
*.sqlite
*.sqlite3
*.db
data/
# Local Dogfood envelope artifacts — user data, never committed (see ER-0154)
*.dogfood.json

# Rust build output
/target/
